        Pour chaque produit | idx
        idx = -1
        sumCump = 0
        sumE = 0

        for i = 0; i < ls.size(); i++
            si Entree :
                qte = mvt(i).qte
                sumE += qte
                si Fifo and idx == -1:
                    idx = i
                    continue 
                
                idx = i
                pu = mvt(i).pu
                si cump :
                    sumCump+= pu * qte

            Sortie and sumE > 0
                qte = mvt(i).qte
                si Lifo :
                    while idx >= 0 and qte > 0:
                        if Entree[idx] and :
                            qteE = mvt(idx).qte
                            qte = max(0, qte - qteE)
                            mvt(idx).qte = qte
                        idx--
                si Fifo 
                    while idx < i and qte > 0:
                        if Entree[idx]:
                            qteE = mvt(idx).qte
                            qte = max(0, qte - qteE)
                            mvt(i).qte = qte
                        idx++
                si Cump :
                    cump = sumCump / sumE
                    qteRestante = sumE - mvt(i).qte 

                    sumCump = qte * cump
                    sumE = qteRestante

